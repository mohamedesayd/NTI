`timescale 1 ps/ 1 ps
module FSM_vlg_vec_tst();
// constants                                           
// general purpose registers
reg a;
reg b;
reg clock;
reg reset;
// wires                                               
wire y0;
wire y1;

// assign statements (if any)                          
FSM i1 (
// port map - connection between master ports and signals/registers   
	.a(a),
	.b(b),
	.clock(clock),
	.reset(reset),
	.y0(y0),
	.y1(y1)
);
initial 
begin 
#1000000 $finish;
end 

// a
initial
begin
	a = 1'b0;
	a = #150000 1'b1;
	a = #30000 1'b0;
	a = #70000 1'b1;
	a = #30000 1'b0;
end 

// b
initial
begin
	b = 1'b0;
	b = #150000 1'b1;
	b = #30000 1'b0;
end 

// clock
always
begin
	clock = 1'b0;
	clock = #5000 1'b1;
	#5000;
end 

// reset
initial
begin
	reset = 1'bZ;
	reset = #100000 1'b0;
	reset = #30000 1'bZ;
end 
endmodule

