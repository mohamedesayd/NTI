`timescale 1 ps/ 1 ps

module FSM (
	reset,
	clock,
	a,
	b,
	y0,
	y1);
input 	reset;
input 	clock;
input 	a;
input 	b;
output 	y0;
output 	y1;

wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \y0~output_o ;
wire \y1~output_o ;
wire \b~input_o ;
wire \a~input_o ;
wire \clock~input_o ;
wire \fstate.S1~0_combout ;
wire \reset~input_o ;
wire \fstate.S1~q ;
wire \Selector0~0_combout ;
wire \fstate.S0~q ;
wire \y0~0_combout ;
wire \fstate.S2~q ;


cyclonev_io_obuf \y0~output (
	.i(\y0~0_combout ),
	.oe(vcc),
	.dynamicterminationcontrol(gnd),
	.seriesterminationcontrol(16'b0000000000000000),
	.parallelterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\y0~output_o ),
	.obar());
// synopsys translate_off
defparam \y0~output .bus_hold = "false";
defparam \y0~output .open_drain_output = "false";
defparam \y0~output .shift_series_termination_control = "false";
// synopsys translate_on

cyclonev_io_obuf \y1~output (
	.i(!\fstate.S2~q ),
	.oe(vcc),
	.dynamicterminationcontrol(gnd),
	.seriesterminationcontrol(16'b0000000000000000),
	.parallelterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\y1~output_o ),
	.obar());
// synopsys translate_off
defparam \y1~output .bus_hold = "false";
